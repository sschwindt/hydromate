# --- Co-development data / example dataset (NOT part of the package) --------
# Real Inn data we develop against; lives here for co-development only.
# (Previously /geodata/, /stage-discharge/ and /geoVis.qgz at the repo root;
#  now consolidated under example-Inn/.)
# Ignore everything under example-Inn/ EXCEPT the top-level example scripts/docs.
/example-Inn/*
!/example-Inn/*.py
!/example-Inn/*.md
/projection.info

# --- Build outputs / generated TELEMAC cases -------------------------------
case/
*.slf

# --- Heavy / geospatial data (safety net, >20 MB and binary GIS) -----------
*.tif
*.tiff
*.tfw
*.gpkg
*.gpkg-shm
*.gpkg-wal

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg

# --- Environments / editors / tooling --------------------------------------
.venv/
.env
.claude/
.idea/
.vscode/
.spyproject/

